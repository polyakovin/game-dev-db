{
  "name": "game-dev-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/run-tool.mjs astro dev",
    "build": "node scripts/run-tool.mjs astro build",
    "preview": "node scripts/run-tool.mjs astro preview",
    "check": "node scripts/run-tool.mjs astro check",
    "check:content": "node scripts/verify-content.mjs",
    "check:dist": "node scripts/verify-dist.mjs",
    "spec": "node scripts/run-tool.mjs openspec",
    "verify": "npm run check && npm run check:content && npm run build && npm run check:dist && npm run spec -- validate --all --strict && python3 scripts/commercial-project.py check .",
    "test": "npm run verify",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts/*.mjs tests *.json *.mjs *.ts",
    "format:check": "prettier --check src scripts/*.mjs tests *.json *.mjs *.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fission-ai/openspec": "1.14.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "cheerio": "1.1.2",
    "gray-matter": "4.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3"
  }
}
