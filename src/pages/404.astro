---
import { SITE_NAME, path } from '../lib/site';
import BrandMark from '../components/BrandMark.astro';
import ThemeHead from '../components/ThemeHead.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <ThemeHead />
    <title>404 · {SITE_NAME}</title>
    <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
    <meta name="robots" content="noindex" />
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: var(--paper);
        color: var(--ink);
        max-width: 600px;
        margin: 15vh auto;
        padding: 24px;
      }
      h1 {
        font-size: 42px;
      }
      p {
        line-height: 1.8;
      }
      a {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <p>
      <BrandMark size={24} /> {SITE_NAME} / 404
    </p>
    <h1>
      Здесь пока пусто.
      <br />
      <span lang="en">Nothing here yet.</span>
    </h1>
    <p>Страница не найдена. / Page not found.</p>
    <p>
      <a href={path('ru/')}>На главную</a> ·{' '}
      <a href={path('en/')} lang="en">
        Knowledge base
      </a>
    </p>
    <CloudflareAnalytics />
  </body>
</html>
