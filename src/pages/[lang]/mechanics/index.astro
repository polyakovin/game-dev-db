---
import Layout from '../../../layouts/Layout.astro';
import MechanicDirections from '../../../components/MechanicDirections.astro';
import { getMechanics } from '../../../lib/mechanics.mjs';
import { getMechanicDirections } from '../../../lib/mechanic-directions.mjs';
import { locales, ui, type Locale } from '../../../lib/site';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ru = lang === 'ru';
const directions = getMechanicDirections(lang);
const counts = getMechanics(lang).reduce(
  (sum, c) => ({
    families: sum.families + c.counts.families,
    variants: sum.variants + c.counts.variants,
  }),
  { families: 0, variants: 0 },
);
---

<Layout
  lang={lang}
  title={ui[lang].mechanics}
  section="mechanics"
  alternate="mechanics/"
>
  <header class="page-header">
    <div class="eyebrow">
      {ru ? 'Справочники для проектирования' : 'References for game design'}
    </div>
    <h1>{ru ? 'Из чего складывается игра.' : 'What makes up a game.'}</h1>
    <p>
      {ru
        ? 'Полная карта направлений: жанры, игровые системы и способы взаимодействия. Открывайте готовые обзоры или исследуйте всю структуру. Материалы, которые ещё готовятся, отмечены «В разработке».'
        : 'A complete map of genres, game systems and ways to interact. Open ready references or explore the full structure. Upcoming materials are labeled “In development”.'}
    </p>
    <div class="article-meta">
      <span>
        {ru ? 'Направления' : 'Directions'}: {directions.counts.directions}
      </span>
      <span>
        {ru ? 'Разделы' : 'Groups'}: {directions.counts.groups}
      </span>
      <span>
        {ru ? 'Готовые материалы' : 'Ready materials'}:{' '}
        {directions.counts.readyMaterials}
      </span>
      <span>
        {ru ? 'Семейства' : 'Families'}: {counts.families}
      </span>
      <span>
        {ru ? 'Варианты' : 'Variants'}: {counts.variants.toLocaleString(lang)}
      </span>
      <span>RU + EN</span>
    </div>
  </header>
  <MechanicDirections lang={lang} />
  <p class="notice mechanics-notice">
    {ru
      ? 'Это рабочие классификации пространства дизайна. Семейства могут пересекаться, а примеры проектирования являются иллюстрациями. Источники подтверждают отдельные приёмы и методологию.'
      : 'These are working classifications of a design space. Families can overlap and design examples are illustrative. Sources support particular techniques and methodology.'}
  </p>
</Layout>
