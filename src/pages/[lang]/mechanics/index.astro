---
import Layout from '../../../layouts/Layout.astro';
import MechanicDirections from '../../../components/MechanicDirections.astro';
import MechanicCardLibrary from '../../../components/MechanicCardLibrary.astro';
import { getMechanics } from '../../../lib/mechanics.mjs';
import { getMechanicDirections } from '../../../lib/mechanic-directions.mjs';
import { locales, ui, type Locale } from '../../../lib/site';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ru = lang === 'ru';
const directions = getMechanicDirections(lang);
const counts = getMechanics(lang).reduce(
  (sum, c) => ({
    families: sum.families + c.counts.families,
    variants: sum.variants + c.counts.variants,
  }),
  { families: 0, variants: 0 },
);
---

<Layout
  lang={lang}
  title={ui[lang].mechanics}
  section="mechanics"
  alternate="mechanics/"
>
  <header class="page-header">
    <div class="eyebrow">
      {ru ? 'Справочники для проектирования' : 'References for game design'}
    </div>
    <h1>{ru ? 'Игровые механики' : 'Game mechanics'}</h1>
    <p>
      {ru
        ? 'Найдите механику по жанру, игровой системе или способу управления. Начните с карточки или откройте обзор направления. Пометка «В разработке» означает, что обзор ещё готовится.'
        : 'Browse mechanics by genre, game system or input method. Start with a card or open a topic overview. “In development” means the overview is still being written.'}
    </p>
    <div class="article-meta">
      <span>
        {ru ? 'Направления' : 'Directions'}: {directions.counts.directions}
      </span>
      <span>
        {ru ? 'Разделы' : 'Groups'}: {directions.counts.groups}
      </span>
      <span>
        {ru ? 'Готовые материалы' : 'Ready materials'}:{' '}
        {directions.counts.readyMaterials}
      </span>
      <span>
        {ru ? 'Семейства' : 'Families'}: {counts.families}
      </span>
      <span>
        {ru ? 'Варианты' : 'Variants'}: {counts.variants.toLocaleString(lang)}
      </span>
      <span>RU + EN</span>
    </div>
  </header>
  <MechanicCardLibrary lang={lang} limit={6} />
  <MechanicDirections lang={lang} />
  <p class="notice mechanics-notice">
    {ru
      ? 'Одна механика может относиться к нескольким семействам. Условные примеры показывают, как можно применить правило. По ссылкам можно подробнее изучить отдельные приёмы и методы проектирования.'
      : 'A mechanic can belong to more than one family. Hypothetical examples show how a rule might work. Follow the sources for details on individual techniques and design methods.'}
  </p>
</Layout>
