---
import Layout from '../../../layouts/Layout.astro';
import MechanicCardLibrary from '../../../components/MechanicCardLibrary.astro';
import { locales, path, type Locale } from '../../../lib/site';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ru = lang === 'ru';
---

<Layout
  lang={lang}
  title={ru ? 'Карточки механик' : 'Mechanic cards'}
  section="mechanics"
  alternate="mechanics/cards/"
>
  <a class="back-link" href={path(`${lang}/mechanics/`)}>
    ← {ru ? 'Все направления' : 'All directions'}
  </a>
  <header class="page-header">
    <h1>{ru ? 'Карточки механик' : 'Mechanic cards'}</h1>
    <p>
      {ru
        ? 'Короткие объяснения, реальные игровые примеры и подсказки на иллюстрациях.'
        : 'Concise explanations, real game examples and contextual image tooltips.'}
    </p>
  </header>
  <MechanicCardLibrary lang={lang} />
</Layout>
