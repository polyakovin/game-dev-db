---
import Layout from '../../../layouts/Layout.astro';
import KnowledgeLinks from '../../../components/KnowledgeLinks.astro';
import {
  getMechanics,
  groupMechanicSections,
} from '../../../lib/mechanics.mjs';
import { locales, path, ui, REPO } from '../../../lib/site';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    getMechanics(lang, { includeArchived: true }).map((catalog) => ({
      params: { lang, id: catalog.id },
      props: { catalog },
    })),
  );
}
const { catalog } = Astro.props;
const lang = catalog.lang;
const ru = lang === 'ru';
const t = ui[lang];
const sectionGroups = groupMechanicSections(catalog.sections);
---

<Layout
  lang={lang}
  title={catalog.title}
  description={catalog.description}
  section="mechanics"
  alternate={`mechanics/${catalog.id}/`}
  robots={catalog.status === 'archived' ? 'noindex, follow' : undefined}
>
  <a class="back-link" href={path(`${lang}/mechanics/`)}>
    ← {ru ? 'Все справочники механик' : 'All mechanic references'}
  </a>
  {(catalog.status === 'archived' ||
    ['children', 'education'].includes(catalog.id)) && (
    <aside
      class="notice catalog-scope-notice"
      data-catalog-scope
      aria-label={ru ? 'Связанные справочники' : 'Related references'}
    >
      {catalog.status === 'archived' ? (
        <>
          <p>
            {ru
              ? 'Этот справочник разделён на два. Детские игры выделены по аудитории, образовательные по учебной цели. Ниже сохранена исходная версия для старых ссылок.'
              : 'This reference has been split into two. Children’s games are defined by audience; educational games by learning purpose. The original version remains below for existing links.'}
          </p>
          <ul>
            {catalog.supersededBy.map((id: string) => (
              <li>
                <a href={path(`${lang}/mechanics/${id}/`)}>
                  {getMechanics(lang).find((c) => c.id === id)?.title}
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : catalog.id === 'children' ? (
        <p>
          {ru
            ? 'Нужна игра с учебной целью? '
            : 'Designing a game with a learning goal? '}
          <a href={path(`${lang}/mechanics/education/`)}>
            {ru
              ? 'Справочник образовательных механик'
              : 'Explore educational mechanics'}
          </a>
        </p>
      ) : (
        <p>
          {ru
            ? 'Проектируете игру для детей? '
            : 'Designing a game for children? '}
          <a href={path(`${lang}/mechanics/children/`)}>
            {ru
              ? 'Свободная игра и другие детские механики'
              : 'Explore open-ended play and other children’s mechanics'}
          </a>
        </p>
      )}
    </aside>
  )}
  <header class="page-header">
    <div class="eyebrow">{ru ? 'Карта механик' : 'Mechanic map'}</div>
    <h1>{catalog.title}</h1>
    <p>{catalog.intro}</p>
    <div class="article-meta">
      <span>
        {ru ? 'Семейства' : 'Families'}: {catalog.counts.families}
      </span>
      <span>
        {ru ? 'Варианты' : 'Variants'}: {catalog.counts.variants}
      </span>
      <span>
        {t.updated}: {catalog.updatedAt}
      </span>
    </div>
    <div class="mechanics-links">
      <a href={path(`content/mechanics/${lang}/${catalog.id}.md`)}>
        {t.markdown}
      </a>
      <a href={path('api/v1/mechanics.json')}>JSON</a>
      <a href={`${REPO}/edit/main/src/data/mechanics/${catalog.id}.json`}>
        {t.edit}
      </a>
    </div>
  </header>
  <div class="mechanics-layout">
    <div class="mechanics-content" data-toc-content>
      <div class="mechanics-controls" hidden>
        <label for="mechanic-search">
          {ru
            ? 'Поиск по механикам и вариантам'
            : 'Search mechanics and variants'}
        </label>
        <div class="search-box">
          <input
            id="mechanic-search"
            type="search"
            autocomplete="off"
            placeholder={
              ru
                ? 'Например, ритм, маршрут или диалог'
                : 'For example, rhythm, route or dialogue'
            }
          />
        </div>
        <label for="mechanic-section">{ru ? 'Раздел' : 'Section'}</label>
        <select id="mechanic-section">
          <option value="all">{ru ? 'Все разделы' : 'All sections'}</option>
          {sectionGroups.map((group) =>
            group.title ? (
              <optgroup label={group.title}>
                {group.sections.map((s) => (
                  <option value={s.id}>{s.title}</option>
                ))}
              </optgroup>
            ) : (
              group.sections.map((s) => <option value={s.id}>{s.title}</option>)
            ),
          )}
        </select>
        <div class="mechanics-actions">
          <button type="button" data-expand>
            {ru ? 'Раскрыть все' : 'Expand all'}
          </button>
          <button type="button" data-collapse>
            {ru ? 'Свернуть все' : 'Collapse all'}
          </button>
          <button type="button" data-reset>
            {ru ? 'Сбросить' : 'Reset'}
          </button>
        </div>
        <p
          data-mechanic-status
          aria-live="polite"
          data-families-label={ru ? 'Семейств' : 'Families'}
          data-variants-label={ru ? 'Вариантов' : 'Variants'}
        ></p>
      </div>
      <div class="empty-state" data-mechanic-empty hidden>
        <h2>{ru ? 'Совпадений нет' : 'No matches'}</h2>
        <p>
          {ru
            ? 'Измените запрос или сбросьте фильтры.'
            : 'Change your query or reset the filters.'}
        </p>
        <button type="button" class="button-primary" data-reset>
          {t.reset}
        </button>
      </div>
      {sectionGroups.map((group) => (
        <div
          class:list={[
            'mechanics-section-group',
            { 'is-grouped': group.title },
          ]}
          data-mechanic-group
        >
          {group.title && <h2>{group.title}</h2>}
          {group.sections.map((section) => {
            const SectionHeading = group.title ? 'h3' : 'h2';
            const BranchHeading = group.title ? 'h4' : 'h3';
            return (
              <section
                id={section.id}
                class="mechanics-section"
                data-mechanic-section
              >
                <SectionHeading>{section.title}</SectionHeading>
                {catalog.families
                  .filter((f) => f.section === section.id)
                  .map((family) => (
                    <details
                      id={family.id}
                      class="mechanic-family"
                      data-family
                      data-section={section.id}
                      data-categories={family.categoryIds.join(' ')}
                    >
                      <summary>
                        <span class="family-number">
                          {catalog.families.indexOf(family) + 1}
                        </span>
                        <span class="family-heading">
                          <strong data-family-title>{family.title}</strong>
                          {family.description && (
                            <span data-family-description>
                              {family.description}
                            </span>
                          )}
                        </span>
                        <span class="family-count">
                          {family.branches.reduce(
                            (n, b) => n + b.variants.length,
                            0,
                          )}
                        </span>
                      </summary>
                      <div class="mechanic-family-body">
                        {family.classification && (
                          <p class="small-note">{family.classification}</p>
                        )}
                        {family.branches.map((branch) => (
                          <section data-branch>
                            <BranchHeading id={branch.id} data-branch-title>
                              {branch.title}
                            </BranchHeading>
                            <ul>
                              {branch.variants.map((variant) => (
                                <li id={variant.id} data-variant>
                                  {variant.text}
                                </li>
                              ))}
                            </ul>
                          </section>
                        ))}
                        {family.example && (
                          <p class="mechanic-example">
                            <strong>
                              {ru
                                ? 'Пример проектирования.'
                                : 'Design example.'}
                            </strong>{' '}
                            {family.example}
                          </p>
                        )}
                        {family.references.length > 0 && (
                          <section data-references>
                            <BranchHeading>
                              {ru
                                ? 'Референсы и материалы'
                                : 'References and further reading'}
                            </BranchHeading>
                            <ul>
                              {family.references.map((reference) => (
                                <li>
                                  <a href={reference.url} data-reference>
                                    {reference.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </section>
                        )}
                        {family.sourceUrls.length > 0 && (
                          <div class="mechanic-example">
                            <span>
                              {family.references.length
                                ? ru
                                  ? 'Источник механики: '
                                  : 'Mechanic source: '
                                : ru
                                  ? 'Контекст и источники: '
                                  : 'Context and sources: '}
                            </span>
                            {family.sourceUrls.map((url, i) => (
                              <>
                                <a href={url}>
                                  {
                                    catalog.sources.find((s) => s.url === url)
                                      ?.title
                                  }
                                </a>
                                {i < family.sourceUrls.length - 1 && ', '}
                              </>
                            ))}
                          </div>
                        )}
                        <KnowledgeLinks
                          identity={`mechanic/${family.canonicalId}`}
                          lang={lang}
                          compact
                        />
                      </div>
                    </details>
                  ))}
              </section>
            );
          })}
        </div>
      ))}
      {catalog.notes.map((note) => (
        <section id={note.id} class="mechanics-note">
          <h2>{note.title}</h2>
          {note.intro && <p>{note.intro}</p>}
          <div class="mechanics-note-grid">
            {note.entries.map((entry) => (
              <div id={entry.id}>
                {entry.title && <h3>{entry.title}</h3>}
                <p>{entry.text}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
      <section id="sources" class="mechanics-note">
        <h2>{ru ? 'Источники и примеры' : 'Sources and examples'}</h2>
        <p>
          {ru
            ? 'Источники подтверждают отдельные приёмы или методологию, а не все варианты семейства. Примеры проектирования и сочетания механик являются иллюстрациями.'
            : 'Sources support particular techniques or methodology, not every family variant. Design examples and mechanic combinations are illustrative.'}
        </p>
        <ul class="mechanics-sources">
          {catalog.sources.map((s) => (
            <li>
              <a href={s.url}>{s.title}</a>
              <p>{s.description}</p>
            </li>
          ))}
        </ul>
        <p class="article-license">CC BY 4.0 · Game Dev DB contributors</p>
      </section>
    </div>
    <aside class="mechanics-toc">
      <nav aria-label={t.toc} data-toc>
        <p class="nav-label">{t.toc}</p>
        {sectionGroups.map((group) => (
          <div class="mechanics-toc-group">
            {group.title && <p class="toc-group-label">{group.title}</p>}
            {group.sections.map((s) => (
              <a href={`#${s.id}`}>{s.title}</a>
            ))}
          </div>
        ))}
        <div
          class:list={[
            'mechanics-toc-notes',
            { 'has-groups': sectionGroups.some((group) => group.title) },
          ]}
        >
          {[
            ...catalog.notes,
            { id: 'sources', title: ru ? 'Источники' : 'Sources' },
          ].map((s) => (
            <a href={`#${s.id}`}>{s.title}</a>
          ))}
        </div>
      </nav>
    </aside>
  </div>
</Layout>
<script>
  import '../../../scripts/mechanics-search';
  import '../../../scripts/table-of-contents';
</script>

<style>
  .catalog-scope-notice {
    margin-bottom: 28px;
  }
  .catalog-scope-notice a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
