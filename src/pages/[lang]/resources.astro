---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import resources from '../../data/resources.json';
import { locales, ui, type Locale } from '../../lib/site';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const kinds: Record<string, string> =
  lang === 'ru'
    ? {
        documentation: 'Документация',
        book: 'Книга',
        article: 'Статья',
        tool: 'Инструмент',
      }
    : {
        documentation: 'Documentation',
        book: 'Book',
        article: 'Article',
        tool: 'Tool',
      };
---

<Layout
  lang={lang}
  title={t.resources}
  section="resources"
  alternate="resources/"
>
  <header class="page-header">
    <div class="eyebrow">
      {lang === 'ru' ? 'Проверенные точки входа' : 'Go to the source'}
    </div>
    <h1>{lang === 'ru' ? 'Хорошие источники.' : 'Good places to learn.'}</h1>
    <p>
      {lang === 'ru'
        ? 'Документация, книги и инструменты, к которым стоит возвращаться. Мы объясняем принципы, а здесь можно копнуть глубже.'
        : 'Documentation, books and tools worth returning to. We explain the principles; these sources help you go deeper.'}
    </p>
  </header>
  <div class="resource-list">
    {resources.map((resource) => (
      <a class="resource-row" href={resource.url}>
        <span class="resource-icon">
          <Icon name={resource.kind === 'tool' ? 'code' : 'book'} size={23} />
        </span>
        <div>
          <div class="resource-meta">
            <span>{kinds[resource.kind]}</span>
            <span>
              {resource.language === 'multi'
                ? 'RU / EN'
                : resource.language.toUpperCase()}
            </span>
          </div>
          <h2>{resource.title[lang]}</h2>
          <p>{resource.description[lang]}</p>
        </div>
        <Icon name="external" size={19} />
      </a>
    ))}
  </div>
  <p class="notice">
    {lang === 'ru'
      ? 'Ссылки ведут на сторонние сайты. Их материалы и лицензии принадлежат авторам. Подборка проверена 9 октября 2026 года.'
      : 'Links lead to third-party sites. Their authors retain the rights and licenses to their work. Selection reviewed on October 9, 2026.'}
  </p>
</Layout>
