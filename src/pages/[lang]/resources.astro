---
import Layout from '../../layouts/Layout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import resources from '../../data/resources.json';
import { locales, type Locale } from '../../lib/site';
import '../../styles/resources.css';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const groups =
  lang === 'ru'
    ? [
        {
          id: 'books',
          title: 'Книги',
          description:
            'От общих принципов и упражнений до нарратива, пространства и ощущения управления.',
        },
        {
          id: 'channels',
          title: 'Каналы и доклады',
          description:
            'Разборы конкретных решений, опыт разработчиков и идеи для игровых миров.',
        },
        {
          id: 'practice',
          title: 'Игры и инструменты для практики',
          description:
            'Меняйте правила, собирайте уровни и проверяйте свои идеи. Для начала достаточно одного маленького эксперимента.',
        },
        {
          id: 'research',
          title: 'Статьи и курсы',
          description:
            'Модели для анализа и материалы для последовательного изучения геймдизайна.',
        },
        {
          id: 'development',
          title: 'Документация и разработка',
          description:
            'Технические первоисточники и рабочие инструменты, которые помогают воплотить дизайн.',
        },
      ]
    : [
        {
          id: 'books',
          title: 'Books',
          description:
            'From principles and exercises to narrative, spaces and the sensation of control.',
        },
        {
          id: 'channels',
          title: 'Channels and talks',
          description:
            'Specific design decisions, developer experience and ideas for fictional worlds.',
        },
        {
          id: 'practice',
          title: 'Games and tools for practice',
          description:
            'Change rules, build levels and test your ideas. Start with one small experiment.',
        },
        {
          id: 'research',
          title: 'Articles and courses',
          description:
            'Analytical models and materials for a structured approach to learning game design.',
        },
        {
          id: 'development',
          title: 'Documentation and development',
          description:
            'Technical primary sources and workflow tools for implementing your design.',
        },
      ];
function groupFor(resource: (typeof resources)[number]) {
  if (resource.category !== 'design') return 'development';
  if (resource.kind === 'book') return 'books';
  if (resource.format === 'channel') return 'channels';
  if (resource.kind === 'tool') return 'practice';
  if (resource.kind === 'article' || resource.format === 'course')
    return 'research';
  return 'development';
}
const selection = groups.map((group) => ({
  ...group,
  resources: resources.filter((resource) => groupFor(resource) === group.id),
}));
const title =
  lang === 'ru' ? 'Референсы для геймдизайна' : 'Game-design references';
const description =
  lang === 'ru'
    ? 'Книги, каналы, игры и инструменты для изучения геймдизайна. У каждого источника есть своя задача: разобраться в принципе, посмотреть на решение в игре или проверить идею руками.'
    : 'Books, channels, games and tools for learning game design. Each source serves a purpose: understand a principle, examine a game’s solution or test an idea yourself.';
---

<Layout
  lang={lang}
  title={title}
  description={description}
  section="resources"
  alternate="resources/"
>
  <header class="page-header">
    <div class="eyebrow">
      {lang === 'ru' ? 'Читать · смотреть · пробовать' : 'Read · watch · try'}
    </div>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <nav
    class="reference-jumps"
    aria-label={lang === 'ru' ? 'Разделы референсов' : 'Reference groups'}
  >
    {selection.map((group) => (
      <a href={`#${group.id}`}>
        {group.title}
        <span>{group.resources.length}</span>
      </a>
    ))}
  </nav>
  {selection.map((group) => (
    <section
      class="reference-group"
      id={group.id}
      aria-labelledby={`${group.id}-title`}
    >
      <h2 id={`${group.id}-title`}>{group.title}</h2>
      <p>{group.description}</p>
      <div class="resource-list">
        {group.resources.map((resource) => (
          <ResourceCard resource={resource} lang={lang} />
        ))}
      </div>
    </section>
  ))}
  <p class="notice">
    {lang === 'ru'
      ? 'Ссылки ведут на сторонние сайты; права на материалы остаются у авторов. Язык указан для страницы по ссылке. Задания «Попробуйте» придуманы для этой подборки. Подборка обновлена 9 октября 2026 года.'
      : 'Links lead to external sites; authors retain the rights to their materials. Language labels describe the linked page. “Try it” prompts are original suggestions for this selection. Updated on October 9, 2026.'}
  </p>
</Layout>
