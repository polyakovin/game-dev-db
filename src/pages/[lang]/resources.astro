---
import Layout from '../../layouts/Layout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getResources, resourceGroup } from '../../lib/resources.mjs';
import { orderEntries } from '../../lib/content-order.mjs';
import { locales, type Locale } from '../../lib/site';
import '../../styles/resources.css';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const groups =
  lang === 'ru'
    ? [
        {
          id: 'books',
          title: 'Книги',
          description:
            'От общих принципов и упражнений до нарратива, пространства и ощущения управления.',
        },
        {
          id: 'channels',
          title: 'Каналы и доклады',
          description:
            'Разборы конкретных решений, опыт разработчиков и идеи для игровых миров.',
        },
        {
          id: 'practice',
          title: 'Игры и инструменты для практики',
          description:
            'Меняйте правила, собирайте уровни и проверяйте свои идеи. Для начала достаточно одного маленького эксперимента.',
        },
        {
          id: 'research',
          title: 'Статьи и курсы',
          description:
            'Модели для анализа и материалы для последовательного изучения геймдизайна.',
        },
        {
          id: 'development',
          title: 'Документация и разработка',
          description:
            'Математика, алгоритмы, графика, звук, ассеты и выпуск игр: технические первоисточники и рабочие инструменты.',
        },
      ]
    : [
        {
          id: 'books',
          title: 'Books',
          description:
            'From principles and exercises to narrative, spaces and the sensation of control.',
        },
        {
          id: 'channels',
          title: 'Channels and talks',
          description:
            'Specific design decisions, developer experience and ideas for fictional worlds.',
        },
        {
          id: 'practice',
          title: 'Games and tools for practice',
          description:
            'Change rules, build levels and test your ideas. Start with one small experiment.',
        },
        {
          id: 'research',
          title: 'Articles and courses',
          description:
            'Analytical models and materials for a structured approach to learning game design.',
        },
        {
          id: 'development',
          title: 'Documentation and development',
          description:
            'Math, algorithms, graphics, audio, assets and releases: technical primary sources and practical tools.',
        },
      ];
const resources = getResources();
const selection = orderEntries(groups, 'resource-groups').map((group) => ({
  ...group,
  resources: resources.filter(
    (resource) => resourceGroup(resource) === group.id,
  ),
}));
const title =
  lang === 'ru' ? 'Ресурсы по разработке игр' : 'Game development resources';
const description =
  lang === 'ru'
    ? 'Книги, курсы, каналы и инструменты по геймдизайну, программированию, графике, звуку и выпуску игр. Смотрите условия доступа, изучайте примеры и проверяйте идеи на практике.'
    : 'Books, courses, channels and tools for game design, programming, graphics, audio and releases. Check access requirements, study examples and test ideas in practice.';
---

<Layout
  lang={lang}
  title={title}
  description={description}
  section="resources"
  alternate="resources/"
>
  <header class="page-header">
    <div class="eyebrow">
      {lang === 'ru' ? 'Читать · смотреть · пробовать' : 'Read · watch · try'}
    </div>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <nav
    class="reference-jumps"
    aria-label={lang === 'ru' ? 'Разделы референсов' : 'Reference groups'}
  >
    {selection.map((group) => (
      <a href={`#${group.id}`}>
        {group.title}
        <span>{group.resources.length}</span>
      </a>
    ))}
  </nav>
  {selection.map((group) => (
    <section
      class="reference-group"
      id={group.id}
      aria-labelledby={`${group.id}-title`}
    >
      <h2 id={`${group.id}-title`}>{group.title}</h2>
      <p>{group.description}</p>
      <div class="resource-list">
        {group.resources.map((resource) => (
          <ResourceCard resource={resource} lang={lang} />
        ))}
      </div>
    </section>
  ))}
  <p class="notice">
    {lang === 'ru'
      ? 'Ссылки ведут на сторонние сайты; права на материалы остаются у авторов. Язык указан для страницы по ссылке. Задания «Попробуйте» придуманы для этой подборки. Подборка обновлена 20 октября 2026 года.'
      : 'Links lead to external sites; authors retain the rights to their materials. Language labels describe the linked page. “Try it” prompts are original suggestions for this selection. Updated on October 20, 2026.'}
  </p>
</Layout>
