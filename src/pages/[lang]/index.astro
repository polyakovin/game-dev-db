---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import MechanicsCards from '../../components/MechanicsCards.astro';
import LearningPaths from '../../components/LearningPaths.astro';
import { getLessons } from '../../lib/content';
import { getPractice } from '../../lib/practice.mjs';
import { getLenses } from '../../lib/lenses.mjs';
import { path, ui, categories, locales, type Locale } from '../../lib/site';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const lessons = await getLessons(lang);
const practice = getPractice(lang);
const lensCatalog = getLenses(lang);
---

<Layout lang={lang} title={t.catalog}>
  <section class="intro">
    <div class="intro-copy">
      <div class="eyebrow">
        <span class="small-cross">+</span>
        {lang === 'ru' ? 'Открытая база знаний' : 'Open knowledge base'}
      </div>
      <h1>
        {lang === 'ru' ? 'Разработка игр' : 'Game development'}
        <br />
        <span>{lang === 'ru' ? 'на практике' : 'in practice'}</span>
      </h1>
      <p class="intro-description">
        {lang === 'ru'
          ? 'Разберитесь, как устроены игровые механики и как проверить их в прототипе. Уроки можно читать на сайте или передавать ИИ-агенту вместе с задачей.'
          : 'Learn how game mechanics work and how to test them in a prototype. Read the lessons here or share one with your AI agent when you give it a task.'}
      </p>
      <div class="intro-meta">
        <span>
          {String(lessons.length).padStart(2, '0')}{' '}
          {lang === 'ru' ? 'материалов' : 'lessons'}
        </span>
        <i></i>
        <span>RU + EN</span>
        <i></i>
        <span>Open source</span>
      </div>
    </div>
    <div class="loop-visual" aria-hidden="true">
      <div class="visual-topline">
        <span>THE GAME LOOP</span>
        <span>↗ 001</span>
      </div>
      <svg class="loop-diagram" viewBox="0 0 320 190" fill="none">
        <defs>
          <pattern
            id="dots"
            width="16"
            height="16"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="var(--diagram-grid)" />
          </pattern>
          <marker
            id="arrowhead"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="5"
            markerHeight="5"
            orient="auto-start-reverse"
          >
            <path
              d="m1 1 7 4-7 4"
              stroke="var(--diagram-line)"
              stroke-width="1.6"
              fill="none"
            />
          </marker>
        </defs>
        <rect width="320" height="190" fill="url(#dots)" />
        <path
          d="M83 84H125 M200 84h38 M264 114v35H57v-35"
          stroke="var(--diagram-line)"
          stroke-width="1.5"
          marker-end="url(#arrowhead)"
        />
        <rect
          x="24"
          y="54"
          width="62"
          height="60"
          rx="10"
          fill="var(--diagram-node)"
          stroke="var(--line-strong)"
        />
        <path
          d="M42 83h26m-13-13v26"
          stroke="var(--diagram-symbol)"
          stroke-width="5"
        />
        <rect
          x="128"
          y="48"
          width="70"
          height="72"
          rx="10"
          fill="var(--accent)"
        />
        <path d="m151 68 25 16-25 16V68Z" fill="var(--on-ink)" />
        <rect
          x="238"
          y="54"
          width="62"
          height="60"
          rx="10"
          fill="var(--diagram-node)"
          stroke="var(--line-strong)"
        />
        <rect
          x="251"
          y="68"
          width="36"
          height="25"
          rx="2"
          stroke="var(--diagram-symbol)"
          stroke-width="2"
        />
        <path
          d="M260 101h18m-9-8v8"
          stroke="var(--diagram-symbol)"
          stroke-width="2"
        />
        <text
          x="55"
          y="39"
          text-anchor="middle"
          fill="var(--muted)"
          font-size="10"
          font-family="monospace"
        >
          INPUT
        </text>
        <text
          x="163"
          y="33"
          text-anchor="middle"
          fill="var(--accent)"
          font-size="10"
          font-family="monospace"
        >
          UPDATE
        </text>
        <text
          x="269"
          y="39"
          text-anchor="middle"
          fill="var(--muted)"
          font-size="10"
          font-family="monospace"
        >
          RENDER
        </text>
      </svg>
      <div class="visual-bottomline">
        <span>{lang === 'ru' ? 'Один кадр' : 'One frame'}</span>
        <span class="visual-pixels">▪ ▪ ▪</span>
      </div>
    </div>
  </section>

  <a class="start-strip" href={path(`${lang}/lessons/scope-and-prototype/`)}>
    <span class="start-icon">
      <Icon name="arrow" />
    </span>
    <span>
      <strong>
        {lang === 'ru' ? 'Первый прототип' : 'Your first prototype'}
      </strong>
      <span class="start-description">
        {lang === 'ru'
          ? 'Выберите одно действие игрока и решите, что хотите проверить.'
          : 'Pick one player action and decide what you want to test.'}
      </span>
    </span>
    <span class="start-action">
      {lang === 'ru' ? 'Выбрать масштаб' : 'Find your scope'}
      <Icon name="arrow" size={16} />
    </span>
  </a>

  <a class="start-strip" href={path(`${lang}/practice/`)}>
    <span class="start-icon">
      <Icon name="play" />
    </span>
    <span>
      <strong>
        {lang === 'ru' ? 'Задачи по геймдизайну' : 'Game design exercises'}
      </strong>
      <span class="start-description">
        {lang === 'ru'
          ? `${practice.counts.tasks} задач. В каждой описано, что собрать и как проверить результат.`
          : `${practice.counts.tasks} exercises. Each gives you something to build and a way to test it.`}
      </span>
    </span>
    <span class="start-action">
      {t.practice}
      <Icon name="arrow" size={16} />
    </span>
  </a>

  <LearningPaths lang={lang} />

  <a class="start-strip" href={path(`${lang}/search/`)} data-global-search-link>
    <span class="start-icon">
      <Icon name="search" />
    </span>
    <span>
      <strong>
        {lang === 'ru'
          ? 'Поиск по всей базе'
          : 'Search the whole knowledge base'}
      </strong>
      <span class="start-description">
        {lang === 'ru'
          ? 'Общий поиск по урокам, механикам, упражнениям, призмам и ресурсам.'
          : 'Search lessons, mechanics, exercises, lenses and resources together.'}
      </span>
    </span>
    <span class="start-action">
      {lang === 'ru' ? 'Открыть поиск' : 'Open search'}
    </span>
  </a>

  <section id="catalog" class="catalog" aria-label={t.catalog}>
    <div class="section-heading">
      <h2>
        {t.lessons}
        <span class="count-badge" data-visible-count>
          {String(lessons.length).padStart(2, '0')}
        </span>
      </h2>
      <span class="section-caption">
        {lang === 'ru'
          ? 'От базовых идей к практике'
          : 'From the fundamentals to practice'}
      </span>
    </div>
    <div class="search-box">
      <Icon name="search" size={21} />
      <label class="sr-only" for="lesson-search">
        {t.searchLabel}
      </label>
      <input
        id="lesson-search"
        type="search"
        placeholder={t.search}
        autocomplete="off"
      />
      <kbd aria-hidden="true">/</kbd>
    </div>
    <div class="filters" role="group" aria-label={t.categories}>
      <button data-category="all" aria-pressed="true">
        {t.all}
      </button>
      {categories.map((category) => (
        <button data-category={category} aria-pressed="false">
          {t[category]}
        </button>
      ))}
    </div>
    <p
      class="result-status sr-only"
      aria-live="polite"
      data-result-status
      data-label={t.results}
    >
      {t.results}: {lessons.length}
    </p>
    <div class="lesson-grid">
      {lessons.map(({ data }, i) => (
        <a
          class="lesson-card"
          href={path(`${lang}/lessons/${data.id}/`)}
          data-lesson-card
          data-card-category={data.category}
          data-search={`${data.id} ${data.title} ${data.description} ${data.tags.join(' ')}`}
        >
          <div class="card-top">
            <span class:list={['category-tag', data.category]}>
              <span></span>
              {t[data.category]}
            </span>
            <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3>{data.title}</h3>
          <p>{data.description}</p>
          <div class="card-bottom">
            <span>
              {t[data.level]}
              <b>·</b>
              {data.minutes} {t.minutes}
            </span>
            <span class="card-arrow">
              <Icon name="arrow" size={18} />
            </span>
          </div>
        </a>
      ))}
    </div>
    <div class="empty-state" hidden>
      <Icon name="search" size={28} />
      <h3>{t.empty}</h3>
      <p>{t.emptyHelp}</p>
      <button id="reset-search" class="button-primary">
        {t.reset}
      </button>
    </div>
    <noscript>
      <p class="notice">
        {lang === 'ru'
          ? 'Поиск и фильтры работают с JavaScript. Все материалы доступны по ссылкам выше.'
          : 'Search and filters use JavaScript. All lessons are available through the links above.'}
      </p>
    </noscript>
  </section>

  <section class="mechanics-home" aria-labelledby="mechanics-heading">
    <div class="section-heading">
      <h2 id="mechanics-heading">{t.mechanics}</h2>
      <a href={path(`${lang}/mechanics/`)}>
        {lang === 'ru' ? 'Все справочники' : 'All references'} →
      </a>
    </div>
    <p>
      {lang === 'ru'
        ? 'Посмотрите, какие действия входят в механику, как меняются её правила и с чем её можно сочетать.'
        : 'See what players can do with a mechanic, how its rules vary and what you can combine it with.'}
    </p>
    <MechanicsCards lang={lang} />
  </section>

  <section class="lenses-home" aria-labelledby="lenses-heading">
    <div class="section-heading">
      <h2 id="lenses-heading">{t.lenses}</h2>
    </div>
    <p>
      {lang === 'ru'
        ? 'Подберите вопросы для разбора конкретной проблемы и решите, что проверить на плейтесте.'
        : 'Find questions for a specific design problem and decide what to test in your next playtest.'}
    </p>
    <a class="lesson-card" data-lenses-card href={path(`${lang}/lenses/`)}>
      <div class="card-top">
        <span class="category-tag design">
          {lang === 'ru' ? 'Проверка дизайна' : 'Design review'}
        </span>
        <span class="card-index">{lensCatalog.counts.total}</span>
      </div>
      <h3>{lensCatalog.title}</h3>
      <p>{lensCatalog.description}</p>
      <div class="card-bottom">
        <span>Jesse Schell · Sebastian Deterding</span>
        <Icon name="arrow" size={18} />
      </div>
    </a>
  </section>

  <a class="start-strip" data-jams-link href={path(`${lang}/jams/`)}>
    <span class="start-icon">
      <Icon name="calendar" />
    </span>
    <span>
      <strong>
        {lang === 'ru' ? 'Календарь геймджемов' : 'Game jam calendar'}
      </strong>
      <span class="start-description">
        {lang === 'ru'
          ? 'Текущие события, ближайшие старты и условия участия.'
          : 'Open events, upcoming starts and entry requirements.'}
      </span>
    </span>
    <span class="start-action">
      {lang === 'ru' ? 'Выбрать джем' : 'Find a jam'}{' '}
      <Icon name="arrow" size={16} />
    </span>
  </a>

  <section class="agent-banner">
    <span class="agent-banner-icon">
      <Icon name="code" size={27} />
    </span>
    <div>
      <div class="eyebrow">
        {lang === 'ru' ? 'Работа с ИИ' : 'Working with AI'}
      </div>
      <h2>
        {lang === 'ru'
          ? 'Как использовать базу с ИИ-агентом'
          : 'Use the knowledge base with an AI agent'}
      </h2>
      <p>
        {lang === 'ru'
          ? 'Передайте агенту ссылку на урок, Markdown или запись из JSON. В руководстве есть готовый запрос.'
          : 'Give your agent a lesson link, a Markdown file or a JSON record. The guide includes a prompt you can use.'}
      </p>
    </div>
    <a href={path(`${lang}/for-agents/`)}>
      {t.agents}
      <Icon name="arrow" size={18} />
    </a>
  </section>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('#lesson-search')!;
  const cards = [
    ...document.querySelectorAll<HTMLElement>('[data-lesson-card]'),
  ];
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-category]'),
  ];
  const empty = document.querySelector<HTMLElement>('.empty-state')!;
  const status = document.querySelector<HTMLElement>('[data-result-status]')!;
  const params = new URLSearchParams(location.search);
  let category = buttons.some(
    (b) => b.dataset.category === params.get('category'),
  )
    ? params.get('category')!
    : 'all';
  input.value = params.get('q') ?? '';
  function filter() {
    const terms = input.value
      .trim()
      .toLocaleLowerCase()
      .split(/\s+/)
      .filter(Boolean);
    let count = 0;
    for (const card of cards) {
      const haystack = card.dataset.search!.toLocaleLowerCase();
      const matches =
        (category === 'all' || card.dataset.cardCategory === category) &&
        terms.every((term) => haystack.includes(term));
      card.hidden = !matches;
      if (matches) count++;
    }
    buttons.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.category === category),
      ),
    );
    status.textContent = `${status.dataset.label}: ${count}`;
    empty.hidden = count > 0;
    document.querySelector('[data-visible-count]')!.textContent = String(
      count,
    ).padStart(2, '0');
    const url = new URL(location.href);
    input.value.trim()
      ? url.searchParams.set('q', input.value.trim())
      : url.searchParams.delete('q');
    category === 'all'
      ? url.searchParams.delete('category')
      : url.searchParams.set('category', category);
    history.replaceState(null, '', url);
  }
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.category!;
      filter();
    }),
  );
  input.addEventListener('input', filter);
  document.querySelector('#reset-search')?.addEventListener('click', () => {
    input.value = '';
    category = 'all';
    filter();
    input.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (
      event.key === '/' &&
      !event.ctrlKey &&
      !event.metaKey &&
      !(event.target instanceof HTMLInputElement) &&
      !(event.target instanceof HTMLTextAreaElement) &&
      !(event.target instanceof HTMLElement && event.target.isContentEditable)
    ) {
      event.preventDefault();
      input.focus();
    }
  });
  filter();
</script>
