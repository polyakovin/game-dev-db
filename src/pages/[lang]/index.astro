---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getLessons } from '../../lib/content';
import { path, ui, categories, locales, type Locale } from '../../lib/site';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const lessons = await getLessons(lang);
---

<Layout lang={lang} title={t.catalog}>
  <section class="intro">
    <div class="intro-copy">
      <div class="eyebrow">
        <span class="small-cross">+</span>
        {lang === 'ru'
          ? 'База знаний о разработке игр'
          : 'An open field guide to game development'}
      </div>
      <h1>
        {lang === 'ru' ? 'От идеи к игре.' : 'From an idea to a game.'}
        <br />
        <span>{lang === 'ru' ? 'С пониманием.' : 'With understanding.'}</span>
      </h1>
      <p class="intro-description">
        {lang === 'ru'
          ? 'Принципы, которые превращают работающий код в хорошую игру. Изучайте сами. Давайте контекст своему ИИ-агенту. Делитесь опытом.'
          : 'Principles that turn working code into a good game. Learn the foundations. Give your AI agent context. Share what you discover.'}
      </p>
      <div class="intro-meta">
        <span>
          {String(lessons.length).padStart(2, '0')}{' '}
          {lang === 'ru' ? 'материалов' : 'lessons'}
        </span>
        <i></i>
        <span>RU + EN</span>
        <i></i>
        <span>Open source</span>
      </div>
    </div>
    <div class="loop-visual" aria-hidden="true">
      <div class="visual-topline">
        <span>THE GAME LOOP</span>
        <span>↗ 001</span>
      </div>
      <svg class="loop-diagram" viewBox="0 0 320 190" fill="none">
        <defs>
          <pattern
            id="dots"
            width="16"
            height="16"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="#dedbd0" />
          </pattern>
          <marker
            id="arrowhead"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="5"
            markerHeight="5"
            orient="auto-start-reverse"
          >
            <path
              d="m1 1 7 4-7 4"
              stroke="#958d7d"
              stroke-width="1.6"
              fill="none"
            />
          </marker>
        </defs>
        <rect width="320" height="190" fill="url(#dots)" />
        <path
          d="M83 84H125 M200 84h38 M264 114v35H57v-35"
          stroke="#958d7d"
          stroke-width="1.5"
          marker-end="url(#arrowhead)"
        />
        <rect
          x="24"
          y="54"
          width="62"
          height="60"
          rx="10"
          fill="#f6f5f0"
          stroke="#c3bdaf"
        />
        <path d="M42 83h26m-13-13v26" stroke="#787263" stroke-width="5" />
        <rect x="128" y="48" width="70" height="72" rx="10" fill="#cd5735" />
        <path d="m151 68 25 16-25 16V68Z" fill="#fff8ed" />
        <rect
          x="238"
          y="54"
          width="62"
          height="60"
          rx="10"
          fill="#f6f5f0"
          stroke="#c3bdaf"
        />
        <rect
          x="251"
          y="68"
          width="36"
          height="25"
          rx="2"
          stroke="#787263"
          stroke-width="2"
        />
        <path d="M260 101h18m-9-8v8" stroke="#787263" stroke-width="2" />
        <text
          x="55"
          y="39"
          text-anchor="middle"
          fill="#777266"
          font-size="10"
          font-family="monospace"
        >
          INPUT
        </text>
        <text
          x="163"
          y="33"
          text-anchor="middle"
          fill="#a2462e"
          font-size="10"
          font-family="monospace"
        >
          UPDATE
        </text>
        <text
          x="269"
          y="39"
          text-anchor="middle"
          fill="#777266"
          font-size="10"
          font-family="monospace"
        >
          RENDER
        </text>
      </svg>
      <div class="visual-bottomline">
        <span>Small steps. Playable worlds.</span>
        <span class="visual-pixels">▪ ▪ ▪</span>
      </div>
    </div>
  </section>

  <a class="start-strip" href={path(`${lang}/lessons/scope-and-prototype/`)}>
    <span class="start-icon">
      <Icon name="arrow" />
    </span>
    <span>
      <strong>
        {lang === 'ru'
          ? 'Первая игра? Начните с малого.'
          : 'Your first game? Start small.'}
      </strong>
      <span class="start-description">
        {lang === 'ru'
          ? 'Одна механика, один прототип, понятный следующий шаг.'
          : 'One mechanic, one prototype, one clear next step.'}
      </span>
    </span>
    <span class="start-action">
      {lang === 'ru' ? 'Выбрать масштаб' : 'Find your scope'}
      <Icon name="arrow" size={16} />
    </span>
  </a>

  <section id="catalog" class="catalog" aria-label={t.catalog}>
    <div class="section-heading">
      <h2>
        {t.lessons}
        <span class="count-badge" data-visible-count>
          {String(lessons.length).padStart(2, '0')}
        </span>
      </h2>
      <span class="section-caption">
        {lang === 'ru'
          ? 'От базовых идей к практике'
          : 'From the fundamentals to practice'}
      </span>
    </div>
    <div class="search-box">
      <Icon name="search" size={21} />
      <label class="sr-only" for="lesson-search">
        {t.searchLabel}
      </label>
      <input
        id="lesson-search"
        type="search"
        placeholder={t.search}
        autocomplete="off"
      />
      <kbd aria-hidden="true">/</kbd>
    </div>
    <div class="filters" role="group" aria-label={t.categories}>
      <button data-category="all" aria-pressed="true">
        {t.all}
      </button>
      {categories.map((category) => (
        <button data-category={category} aria-pressed="false">
          {t[category]}
        </button>
      ))}
    </div>
    <p
      class="result-status sr-only"
      aria-live="polite"
      data-result-status
      data-label={t.results}
    >
      {t.results}: {lessons.length}
    </p>
    <div class="lesson-grid">
      {lessons.map(({ data }, i) => (
        <a
          class="lesson-card"
          href={path(`${lang}/lessons/${data.id}/`)}
          data-lesson-card
          data-card-category={data.category}
          data-search={`${data.id} ${data.title} ${data.description} ${data.tags.join(' ')}`}
        >
          <div class="card-top">
            <span class:list={['category-tag', data.category]}>
              <span></span>
              {t[data.category]}
            </span>
            <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3>{data.title}</h3>
          <p>{data.description}</p>
          <div class="card-bottom">
            <span>
              {t[data.level]}
              <b>·</b>
              {data.minutes} {t.minutes}
            </span>
            <span class="card-arrow">
              <Icon name="arrow" size={18} />
            </span>
          </div>
        </a>
      ))}
    </div>
    <div class="empty-state" hidden>
      <Icon name="search" size={28} />
      <h3>{t.empty}</h3>
      <p>{t.emptyHelp}</p>
      <button id="reset-search" class="button-primary">
        {t.reset}
      </button>
    </div>
    <noscript>
      <p class="notice">
        {lang === 'ru'
          ? 'Поиск и фильтры работают с JavaScript. Все материалы доступны по ссылкам выше.'
          : 'Search and filters use JavaScript. All lessons are available through the links above.'}
      </p>
    </noscript>
  </section>

  <section class="agent-banner">
    <span class="agent-banner-icon">
      <Icon name="code" size={27} />
    </span>
    <div>
      <div class="eyebrow">HUMAN READABLE. AGENT READY.</div>
      <h2>
        {lang === 'ru'
          ? 'Одна база знаний. Два способа читать.'
          : 'One knowledge base. Two ways to read.'}
      </h2>
      <p>
        {lang === 'ru'
          ? 'Статьи для вас. Markdown и структурированные данные для вашего агента.'
          : 'Articles for you. Markdown and structured data for your agent.'}
      </p>
    </div>
    <a href={path(`${lang}/for-agents/`)}>
      {t.agents}
      <Icon name="arrow" size={18} />
    </a>
  </section>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('#lesson-search')!;
  const cards = [
    ...document.querySelectorAll<HTMLElement>('[data-lesson-card]'),
  ];
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-category]'),
  ];
  const empty = document.querySelector<HTMLElement>('.empty-state')!;
  const status = document.querySelector<HTMLElement>('[data-result-status]')!;
  const params = new URLSearchParams(location.search);
  let category = buttons.some(
    (b) => b.dataset.category === params.get('category'),
  )
    ? params.get('category')!
    : 'all';
  input.value = params.get('q') ?? '';
  function filter() {
    const terms = input.value
      .trim()
      .toLocaleLowerCase()
      .split(/\s+/)
      .filter(Boolean);
    let count = 0;
    for (const card of cards) {
      const haystack = card.dataset.search!.toLocaleLowerCase();
      const matches =
        (category === 'all' || card.dataset.cardCategory === category) &&
        terms.every((term) => haystack.includes(term));
      card.hidden = !matches;
      if (matches) count++;
    }
    buttons.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.category === category),
      ),
    );
    status.textContent = `${status.dataset.label}: ${count}`;
    empty.hidden = count > 0;
    document.querySelector('[data-visible-count]')!.textContent = String(
      count,
    ).padStart(2, '0');
    const url = new URL(location.href);
    input.value.trim()
      ? url.searchParams.set('q', input.value.trim())
      : url.searchParams.delete('q');
    category === 'all'
      ? url.searchParams.delete('category')
      : url.searchParams.set('category', category);
    history.replaceState(null, '', url);
  }
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.category!;
      filter();
    }),
  );
  input.addEventListener('input', filter);
  document.querySelector('#reset-search')?.addEventListener('click', () => {
    input.value = '';
    category = 'all';
    filter();
    input.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (
      event.key === '/' &&
      !event.ctrlKey &&
      !event.metaKey &&
      !(event.target instanceof HTMLInputElement) &&
      !(event.target instanceof HTMLTextAreaElement) &&
      !(event.target instanceof HTMLElement && event.target.isContentEditable)
    ) {
      event.preventDefault();
      input.focus();
    }
  });
  filter();
</script>
