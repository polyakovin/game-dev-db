---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { path, absolute, REPO, ui, categories, type Locale } from '../lib/site';
interface Props {
  lang: Locale;
  title: string;
  description?: string;
  section?:
    | 'catalog'
    | 'searchNav'
    | 'mechanics'
    | 'practice'
    | 'lenses'
    | 'jams'
    | 'resources'
    | 'agents';
  alternate?: string;
  formats?: { markdownUrl: string; jsonUrl: string };
  structuredData?: Record<string, unknown>;
  robots?: string;
  compact?: boolean;
}
const {
  lang,
  title,
  description = lang === 'ru'
    ? 'Принципы разработки игр для людей и ИИ-агентов. Открытая база знаний на русском и английском.'
    : 'Game development principles for people and AI agents. An open knowledge base in Russian and English.',
  section = 'catalog',
  alternate = '',
  formats,
  structuredData,
  robots,
  compact = false,
} = Astro.props;
const t = ui[lang];
const other = lang === 'ru' ? 'en' : 'ru';
const canonical = new URL(Astro.url.pathname, 'https://polyakovin.github.io')
  .href;
const nav = [
  { key: 'catalog', href: path(`${lang}/`), icon: 'book' },
  { key: 'searchNav', href: path(`${lang}/search/`), icon: 'search' },
  { key: 'mechanics', href: path(`${lang}/mechanics/`), icon: 'layers' },
  { key: 'lenses', href: path(`${lang}/lenses/`), icon: 'search' },
  { key: 'practice', href: path(`${lang}/practice/`), icon: 'play' },
  { key: 'jams', href: path(`${lang}/jams/`), icon: 'calendar' },
  { key: 'resources', href: path(`${lang}/resources/`), icon: 'layers' },
  { key: 'agents', href: path(`${lang}/for-agents/`), icon: 'code' },
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <ThemeHead />
    <title>{title} · Game Dev DB</title>
    <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={absolute(`ru/${alternate}`)} />
    <link rel="alternate" hreflang="en" href={absolute(`en/${alternate}`)} />
    <link
      rel="help"
      type="text/plain"
      href={path('llms.txt')}
      title="Game Dev DB agent index"
    />
    {formats && (
      <>
        <link
          rel="alternate"
          type="text/markdown"
          href={formats.markdownUrl}
          title="Markdown"
        />
        <link
          rel="alternate"
          type="application/json"
          href={formats.jsonUrl}
          title="Knowledge record"
        />
      </>
    )}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      />
    )}
    <link
      rel="alternate"
      type="application/json"
      href={path('api/v1/manifest.json')}
      title="Machine-readable manifest"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Game Dev DB`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
  </head>
  <body class:list={{ 'compact-page': compact }}>
    <a href="#main" class="skip-link">
      {t.skip}
    </a>
    {!compact && (
      <aside class="sidebar">
        <a class="brand" href={path(`${lang}/`)} aria-label="Game Dev DB">
          <span class="brand-mark" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>
            game dev<span class="brand-db">/ db</span>
          </span>
        </a>
        <div class="sidebar-caption">{t.tagline}</div>
        <nav aria-label={t.navigation}>
          <p class="nav-label">{t.navigation}</p>
          {nav.map(({ key, href, icon }) => (
            <a
              href={href}
              class:list={['nav-item', { active: section === key }]}
              aria-current={section === key ? 'page' : undefined}
            >
              <Icon name={icon} />
              <span>{t[key]}</span>
              {section === key && <span class="nav-dot"></span>}
            </a>
          ))}
          <p class="nav-label category-nav-label">{t.categories}</p>
          <div class="category-nav">
            {categories.map((category, i) => (
              <a href={path(`${lang}/?category=${category}#catalog`)}>
                <span class="category-number">0{i + 1}</span>
                {t[category]}
              </a>
            ))}
          </div>
        </nav>
        <div class="sidebar-bottom">
          <div class="open-label">
            <span></span>
            {t.open}
          </div>
          <p>
            {lang === 'ru'
              ? 'Хорошие игры начинаются с понятных принципов.'
              : 'Good games start with principles you understand.'}
          </p>
          <a href={`${REPO}/blob/main/CONTRIBUTING.md`} class="contribute-link">
            {t.contribute}
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </aside>
    )}
    <div class="workspace">
      <header class="topbar">
        <div class="breadcrumb">
          {compact ? (
            <a class="compact-brand" href={path(`${lang}/`)}>
              game dev <span>/ db</span>
            </a>
          ) : (
            <>
              <span class="mobile-brand">game dev / db</span>
              <span class="desktop-crumb">
                Game Dev DB <span class="slash">/</span>{' '}
                <span>{t[section]}</span>
              </span>
            </>
          )}
        </div>
        <div class="topbar-actions">
          <ThemeSwitch lang={lang} />
          <div
            class="language-switch"
            aria-label={lang === 'ru' ? 'Язык' : 'Language'}
          >
            <span aria-current="true">{lang.toUpperCase()}</span>
            <a
              data-language-switch
              href={path(`${other}/${alternate}`)}
              lang={other}
              hreflang={other}
            >
              {other.toUpperCase()}
            </a>
          </div>
          <a class="github-link" href={REPO} aria-label="GitHub">
            <Icon name="github" size={18} />
            <span>GitHub</span>
            <Icon name="external" size={13} />
          </a>
        </div>
      </header>
      {!compact && (
        <nav class="mobile-nav" aria-label={t.navigation}>
          {nav.map(({ key, href }) => (
            <a href={href} aria-current={section === key ? 'page' : undefined}>
              {t[key]}
            </a>
          ))}
        </nav>
      )}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {!compact && <SiteFooter lang={lang} />}
    </div>
  </body>
</html>
<style is:global>
  .compact-page .workspace {
    margin-left: 0;
  }
  .compact-page .topbar {
    height: 64px;
    flex-wrap: wrap;
    padding: 0 max(24px, calc((100vw - 1200px) / 2));
  }
  .compact-page main {
    max-width: 1200px;
    min-height: 0;
    padding: 24px 32px 18px;
  }
  .compact-brand {
    color: var(--ink);
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.8px;
    white-space: nowrap;
  }
  .compact-brand span {
    color: var(--accent);
  }
  @media (max-width: 700px) {
    .compact-page .topbar {
      min-height: 50px;
      height: auto;
      padding: 6px 16px;
    }
    .compact-page .github-link {
      display: none;
    }
    .compact-page .topbar-actions {
      gap: 8px;
    }
    .compact-page main {
      padding: 12px 16px;
    }
    .compact-brand {
      font-size: 16px;
    }
  }
</style>
