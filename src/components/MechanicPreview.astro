---
import type { KnowledgeRecord } from '../lib/knowledge-content';
import { path } from '../lib/site';
interface Props {
  record: KnowledgeRecord;
}
const { record } = Astro.props;
const preview = record.attributes.preview!;
const { image } = preview;
const crop = image.crop ?? {
  x: 0,
  y: 0,
  width: image.width,
  height: image.height,
};
const ru = record.lang === 'ru';
const local = (url: string) => new URL(url).pathname + new URL(url).hash;
---

<article class="mechanic-preview" data-mechanic-preview={record.key}>
  <header class="preview-header">
    <h1>{record.title}</h1>
    <nav
      class="preview-categories"
      aria-label={ru ? 'Категории механики' : 'Mechanic categories'}
    >
      {record.placements.map((placement) => (
        <a href={local(placement.url)}>
          {placement.title.replace(ru ? ' механики' : ' mechanics', '')}
        </a>
      ))}
    </nav>
  </header>

  <div class="preview-grid">
    <figure class="preview-figure">
      <div class="preview-viewport">
        <div
          class="preview-image"
          data-image-crop
          style={`--image-ratio:${crop.width / crop.height};--source-width:${(image.width / crop.width) * 100}%;--source-x:${(-crop.x / crop.width) * 100}%;--source-y:${(-crop.y / crop.height) * 100}%`}
        >
          <img
            src={path(image.src)}
            width={image.width}
            height={image.height}
            alt={image.alt}
            fetchpriority="high"
          />
          {image.markers.map((marker, i) => (
            <>
              <button
                type="button"
                class="preview-marker"
                style={`left:clamp(16px,${(((marker.x / 100) * image.width - crop.x) / crop.width) * 100}%,calc(100% - 16px));top:clamp(16px,${(((marker.y / 100) * image.height - crop.y) / crop.height) * 100}%,calc(100% - 16px))`}
                aria-label={`${ru ? 'Метка' : 'Marker'} ${i + 1}`}
                aria-describedby={`mechanic-tooltip-${i + 1}`}
                title={marker.label}
              >
                {i + 1}
              </button>
              <span
                id={`mechanic-tooltip-${i + 1}`}
                class="preview-tooltip"
                role="tooltip"
                popover="manual"
              >
                {marker.label}
              </span>
            </>
          ))}
        </div>
      </div>
      <figcaption>
        <div class="preview-image-title">
          <strong>{image.game}</strong>
          <span>{image.caption}</span>
        </div>
        <ol class="preview-legend">
          {image.markers.map((marker) => (
            <li>{marker.label}</li>
          ))}
        </ol>
        <a class="preview-credit" href={image.sourceUrl} title={image.rights}>
          © {image.credit} · {ru ? 'Пресс-кит' : 'Press kit'} ↗
        </a>
      </figcaption>
    </figure>
    <p class="preview-description">{preview.description}</p>

    <section class="preview-tips" aria-labelledby="preview-tips-heading">
      <h2 id="preview-tips-heading">{ru ? 'Как применять' : 'Design tips'}</h2>
      <ul>
        {preview.tips.map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </section>
    <section
      class="preview-examples"
      id="sources"
      aria-labelledby="preview-examples-heading"
    >
      <h2 id="preview-examples-heading">{ru ? 'Ещё примеры' : 'Examples'}</h2>
      <div>
        {record.sources.map((source) => (
          <a href={source.url}>{source.title} ↗</a>
        ))}
      </div>
    </section>
  </div>

  <footer class="preview-footer">
    <span>
      {ru ? 'Текст' : 'Text'}:{' '}
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> ·
      Game Dev DB
    </span>
    <nav aria-label={ru ? 'Полные данные механики' : 'Full mechanic data'}>
      <a href={local(record.markdownUrl)}>Markdown</a>
      <a href={local(record.jsonUrl)}>JSON</a>
    </nav>
  </footer>
</article>
<script>
  import '../scripts/mechanic-tooltips';
</script>

<style>
  .mechanic-preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(160px, 1fr) auto auto auto;
    grid-template-areas: 'heading' 'description' 'figure' 'tips' 'examples' 'footer';
    gap: 10px;
    block-size: 100%;
    min-block-size: min-content;
    overflow-wrap: anywhere;
  }
  .preview-grid {
    display: contents;
  }
  .preview-header {
    grid-area: heading;
    min-width: 0;
  }
  h1 {
    font-size: clamp(26px, 3vw, 56px);
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin: 0 0 10px;
  }
  a:hover {
    color: var(--accent);
  }
  .preview-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .preview-categories a {
    font-size: clamp(10px, 0.8vw, 13px);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 7px;
    color: var(--muted);
  }
  .preview-description {
    grid-area: description;
    font-size: clamp(14px, 1.35vw, 22px);
    line-height: 1.45;
    margin: 0;
  }
  .preview-figure {
    grid-area: figure;
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .preview-viewport {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    container-type: size;
    background: #fff;
    border-radius: 8px 8px 0 0;
  }
  .preview-image {
    position: relative;
    width: min(100cqw, calc(100cqh * var(--image-ratio)));
    aspect-ratio: var(--image-ratio);
    overflow: clip;
  }
  img {
    display: block;
    position: absolute;
    width: var(--source-width);
    max-width: none;
    height: auto;
    left: var(--source-x);
    top: var(--source-y);
  }
  .preview-marker {
    position: absolute;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: clamp(18px, 2vw, 30px);
    height: clamp(18px, 2vw, 30px);
    background: #c75031;
    color: #fff;
    border: 2px solid #fff;
    border-radius: 50%;
    padding: 0;
    cursor: help;
    font:
      600 clamp(10px, 1vw, 14px) 'IBM Plex Mono',
      monospace;
    box-shadow: 0 1px 5px #0003;
  }
  .preview-tooltip {
    position: fixed;
    inset: auto;
    margin: 0;
    width: max-content;
    max-width: min(260px, calc(100vw - 24px));
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: 0 4px 16px #0003;
    font:
      13px/1.4 'Golos Text Variable',
      system-ui,
      sans-serif;
    overflow-wrap: anywhere;
  }
  figcaption {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 12px;
    border-top: 1px solid var(--line);
    line-height: 1.25;
  }
  .preview-image-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 3px 8px;
    font-size: clamp(10px, 0.85vw, 13px);
  }
  .preview-image-title strong {
    font-weight: 600;
  }
  .preview-image-title span {
    color: var(--muted);
  }
  .preview-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 14px;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: markers;
    font-size: clamp(10px, 0.8vw, 12px);
  }
  .preview-legend li {
    display: flex;
    align-items: center;
    gap: 5px;
    counter-increment: markers;
  }
  .preview-legend li::before {
    content: counter(markers);
    font:
      500 10px 'IBM Plex Mono',
      monospace;
    color: var(--accent);
  }
  .preview-credit {
    font-size: clamp(9px, 0.7vw, 11px);
    color: var(--muted);
  }
  h2 {
    font:
      500 clamp(10px, 0.8vw, 12px) 'IBM Plex Mono',
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 6px;
  }
  .preview-tips {
    grid-area: tips;
  }
  .preview-tips ul {
    padding-left: 16px;
    margin: 0;
    font-size: clamp(13px, 1.05vw, 18px);
    line-height: 1.4;
  }
  .preview-tips li + li {
    margin-top: 4px;
  }
  .preview-tips li::marker {
    color: var(--accent);
  }
  .preview-examples {
    grid-area: examples;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .preview-examples h2 {
    margin: 0;
  }
  .preview-examples div {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 14px;
    font-size: clamp(11px, 0.95vw, 16px);
  }
  .preview-examples a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .preview-footer {
    grid-area: footer;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    border-top: 1px solid var(--line);
    padding-top: 6px;
    color: var(--muted);
    font-size: clamp(9px, 0.7vw, 11px);
    line-height: 1.3;
  }
  .preview-footer nav {
    display: flex;
    gap: 12px;
  }
  @media (min-width: 740px), (min-width: 480px) and (max-height: 550px) {
    .mechanic-preview {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: minmax(auto, 1fr) auto auto minmax(auto, 1fr) auto;
      grid-template-areas: 'figure heading' 'figure description' 'figure tips' 'figure examples' 'footer footer';
      column-gap: clamp(18px, 3vw, 64px);
      row-gap: clamp(12px, 2vh, 24px);
    }
    .preview-header {
      align-self: end;
    }
    .preview-examples {
      align-self: start;
    }
    .preview-tips {
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }
  }
  @media (max-width: 739px) and (min-height: 551px) {
    .mechanic-preview {
      gap: 8px;
    }
  }
  @media (max-width: 479px) and (max-height: 639px) {
    .preview-tips,
    .preview-examples {
      display: none;
    }
    .mechanic-preview {
      grid-template-rows: auto auto minmax(160px, 1fr) auto;
      grid-template-areas: 'heading' 'description' 'figure' 'footer';
      gap: 8px;
    }
  }
  @media (min-width: 480px) and (max-height: 580px) {
    .preview-examples {
      display: none;
    }
  }
  @media (min-width: 480px) and (max-width: 619px) and (max-height: 550px) {
    .preview-tips {
      display: none;
    }
  }
  @media (min-width: 480px) and (max-height: 459px) {
    .preview-tips {
      display: none;
    }
    .mechanic-preview {
      grid-template-rows: auto 1fr auto;
      grid-template-areas: 'figure heading' 'figure description' 'footer footer';
      row-gap: 8px;
      column-gap: 16px;
    }
    h1 {
      font-size: clamp(22px, 3vw, 34px);
      margin-bottom: 6px;
    }
    .preview-description {
      font-size: 13px;
    }
    .preview-image-title span {
      display: none;
    }
    figcaption {
      padding: 5px 8px;
      gap: 3px;
    }
  }
  @media (max-width: 620px) and (max-height: 640px),
    (max-width: 900px) and (max-height: 400px) {
    .mechanic-preview {
      min-block-size: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr);
      grid-template-areas: 'heading' 'description' 'figure';
      gap: 12px;
    }
    .preview-categories,
    figcaption,
    .preview-tips,
    .preview-examples,
    .preview-footer {
      display: none;
    }
    h1 {
      margin: 0;
    }
    .preview-figure {
      border: 0;
      background: transparent;
    }
    .preview-viewport {
      background: transparent;
      border-radius: 8px;
    }
    .preview-image {
      background: #fff;
      border-radius: 8px;
    }
  }
  @media (min-width: 480px) and (max-width: 900px) and (max-height: 400px) {
    .mechanic-preview {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr 1fr;
      grid-template-areas: 'figure heading' 'figure description';
      column-gap: 16px;
    }
    .preview-description {
      align-self: start;
    }
  }
  @media (max-width: 479px) and (max-height: 400px) {
    .mechanic-preview {
      display: flow-root;
    }
    .preview-header {
      margin-bottom: 12px;
    }
    h1 {
      font-size: 24px;
    }
    .preview-figure {
      float: inline-end;
      width: min(50%, calc(100svh - 80px));
      aspect-ratio: 1;
      margin: 0 0 8px 12px;
    }
    .preview-viewport {
      block-size: 100%;
    }
    .preview-description {
      font-size: 14px;
    }
  }
  @container mechanic-shell (max-width: 230px) {
    .mechanic-preview {
      display: flex;
      flex-direction: column;
      block-size: auto;
    }
    .preview-figure {
      float: none;
      width: auto;
      flex: none;
      block-size: 270px;
    }
    .preview-tips,
    .preview-examples {
      display: block;
    }
  }
</style>
